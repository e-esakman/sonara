# Backend URL for HTTP API calls (pronunciation analysis, etc.)
# Defaults to http://localhost:8080 when not set
VITE_BACKEND_URL=http://localhost:8080

# Backend WebSocket URL for the Gemini Live AI Coach proxy
# Defaults to ws://localhost:8080/live-ws when not set
VITE_BACKEND_WS_URL=ws://localhost:8080/live-ws

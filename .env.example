# Backend URL for HTTP API calls (pronunciation analysis, etc.)
# Defaults to http://localhost:3000 when not set
VITE_BACKEND_URL=http://localhost:3000

# Backend WebSocket URL for the Gemini Live AI Coach proxy
# Defaults to ws://localhost:3000/live-ws when not set
VITE_BACKEND_WS_URL=ws://localhost:3000/live-ws

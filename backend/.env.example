# Server port (defaults to 3000)
PORT=3000

# Google Gemini API key — keep this secret, never commit to source control
# Used as a fallback for all Gemini-powered features when specific keys are not set.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: dedicated key for the feedback & grammar agents (overrides GEMINI_API_KEY for those features)
GEMINI_FEEDBACK_KEY=your_gemini_feedback_key_here

# Optional: dedicated key for the Gemini Live voice proxy at /live-ws (overrides GEMINI_API_KEY)
GEMINI_LIVEVOICE_KEY=your_gemini_livevoice_key_here

# Allowed CORS origins (comma-separated). Defaults to http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Firebase Admin SDK (for persistent progress tracking) ────────────────────
#
# Option 1 (recommended): paste the entire service-account JSON as a single-line
# string.  Download the file from Firebase Console → Project Settings →
# Service Accounts → Generate new private key, then run:
#
#   node -e "const fs=require('fs'); \
#     console.log(JSON.stringify(JSON.parse(fs.readFileSync('serviceAccount.json','utf8'))))" \
#     > /tmp/sa_oneliner.txt
#
# Then set:
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
#
# If FIREBASE_SERVICE_ACCOUNT is not set, the server will start in demo mode
# where progress data is accepted but not persisted between restarts.
FIREBASE_SERVICE_ACCOUNT=
